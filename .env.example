# Local development only — copy to .env and adjust if needed.
# These credentials match docker-compose.yml and are NOT for production.

DATABASE_URL=postgresql+psycopg://superdocs:superdocs_dev_password@localhost:5432/superdocs

SUPERDOCS_BASE_URL=https://api.superdocs.app
SUPERDOCS_API_KEY=your_superdocs_api_key_here

# Local document root for PackageDocument.storage_path resolution
UPLOADS_ROOT=uploads
